# =============================================================
# GonKenLab Agent — legacy migration example
# =============================================================
# Normal runtime does not load .env. Use this only as an input to
# `gonken-agent config migrate`; the command writes validated TOML and keeps a
# timestamped backup. Offline core rejects populated external-service keys.

# Recognized obsolete keys must remain empty for offline-core migration.
OPENWEATHER_API_KEY=
NEWSAPI_KEY=
MOONSHOT_API_KEY=

# Migratable USB device-name substrings. AIRHUG matches devices such as
# "AIRHUG 01: USB Audio (hw:0,0)" and survives ALSA card renumbering.
GONKEN_MIC_NAME=AIRHUG
GONKEN_SPEAKER_NAME=AIRHUG
