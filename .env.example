# =============================================================
# GonKenLab Agent — optional external services and local overrides
# =============================================================
# setup.sh copies this file to .env once. Keep .env private.
# All API keys are OPTIONAL; the local Ollama/Whisper/Piper path
# works without them.

# External features
OPENWEATHER_API_KEY=
NEWSAPI_KEY=
MOONSHOT_API_KEY=

# USB audio device-name substrings. AIRHUG matches devices such as
# "AIRHUG 01: USB Audio (hw:0,0)" and survives ALSA card renumbering.
GONKEN_MIC_NAME=AIRHUG
GONKEN_SPEAKER_NAME=AIRHUG
