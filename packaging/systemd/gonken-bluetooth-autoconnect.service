[Unit]
Description=GonKenLab Agent trusted Bluetooth audio reconnect helper
Documentation=man:systemd.service(5)
Wants=bluetooth.service
After=bluetooth.service
ConditionPathExists=/etc/gonken-agent/bluetooth-device.record
ConditionPathIsDirectory=/usr/local/lib/gonken-agent/current

[Service]
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1
Type=simple
ExecStart=/usr/local/lib/gonken-agent/current/maintenance/bluetooth_manager.py watch --record /etc/gonken-agent/bluetooth-device.record --audio-user gonken-agent
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadOnlyPaths=/etc/gonken-agent/bluetooth-device.record /usr/local/lib/gonken-agent/current
RestrictAddressFamilies=AF_UNIX
# The root reconnect helper may clear a Bluetooth software rfkill block and
# therefore retains CAP_NET_ADMIN, plus only the UID/GID-drop capabilities needed
# for pactl inside the dedicated audio user session.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SETUID CAP_SETGID

[Install]
WantedBy=multi-user.target
