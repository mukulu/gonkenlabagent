[Unit]
Description=GonKenLab Agent headless offline assistant
Documentation=man:systemd.service(5)
Wants=ollama.service
After=network-online.target ollama.service
ConditionPathIsDirectory=/usr/local/lib/gonken-agent/current
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
User=gonken-agent
Group=gonken-agent
WorkingDirectory=/usr/local/lib/gonken-agent/current
EnvironmentFile=-/etc/gonken-agent/environment
# Release reconciliation owns root-only activation state. The '+' prefix keeps
# this bounded immutable helper privileged while the long-running service stays
# on the dedicated non-login account.
ExecStartPre=+/usr/local/lib/gonken-agent/current/maintenance/reconcile-release.sh
ExecStart=/usr/local/lib/gonken-agent/current/.venv/bin/gonken-agent service --diagnostic-mode debug
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
RuntimeDirectory=gonken-agent
CacheDirectory=gonken-agent
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
# When the optional Bluetooth extension is enabled, a lingering PipeWire user
# session lives below /run/user/<uid>. These variables are harmless when that
# extension is absent and let the same service reach its own local audio graph.
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
# The main service account still cannot mutate install state because the
# directory remains root:root 0700; this mount allowance exists so the bounded
# privileged ExecStartPre can finish an interrupted activation journal.
ReadWritePaths=/var/lib/gonken-agent/install /var/lib/gonken-agent/runtime /var/cache/gonken-agent /run/gonken-agent
# Corpus provisioning is optional. '-' means absence is not a namespace setup
# failure; if the corpus exists it is exposed read-only to the service.
ReadOnlyPaths=-/srv/gonken-agent/corpus
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
PrivateDevices=false

[Install]
WantedBy=multi-user.target
